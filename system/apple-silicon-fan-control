#!/usr/bin/env bash
set -euo pipefail

# Secure environment sanitization
export PATH="/usr/bin:/bin"
unset IFS LD_PRELOAD LD_LIBRARY_PATH

# Enforce root execution
if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Error: apple-silicon-fan-control must run as root." >&2
  exit 1
fi

# Strictly enforce exactly one argument
if [[ $# -ne 1 ]]; then
  echo "Usage: apple-silicon-fan-control <auto | RPM (clamped to each fan's min..max)>" >&2
  exit 64
fi

ACTION="$1"

# Validate argument: must be 'auto' or a 4-digit RPM (same pattern as the sudoers rule)
if [[ ! "$ACTION" =~ ^(auto|[1-7][0-9]{3})$ ]]; then
  echo "Error: Invalid argument '$ACTION'. Must be 'auto' or a 4-digit RPM." >&2
  exit 2
fi

# Numeric targets are clamped later to each fan's own hardware min/max, since
# fans in the same Mac can have different limits (e.g. 14" M1 Pro: 5798 and 6241 RPM).
TARGET=0
if [[ "$ACTION" != "auto" ]]; then
  TARGET=$((10#$ACTION))
fi

# Discover macsmc_hwmon
HWMON_DIR=""
for d in /sys/class/hwmon/hwmon*; do
  if [[ -f "$d/name" ]] && [[ "$(< "$d/name")" == "macsmc_hwmon" ]]; then
    HWMON_DIR="$d"
    break
  fi
done

if [[ -z "$HWMON_DIR" ]]; then
  echo "Error: macsmc_hwmon not found in sysfs." >&2
  exit 1
fi

# Ensure target path canonicalizes safely inside /sys
REAL_HWMON=$(realpath "$HWMON_DIR" 2>/dev/null || true)
if [[ -z "$REAL_HWMON" || ! "$REAL_HWMON" =~ ^/sys/ ]]; then
  echo "Security error: macsmc_hwmon path does not resolve inside /sys: $REAL_HWMON" >&2
  exit 1
fi

# Ensure kernel fan control parameter is enabled
FC_PARAM="/sys/module/macsmc_hwmon/parameters/fan_control"
if [[ -f "$FC_PARAM" ]]; then
  FC_VAL=$(cat "$FC_PARAM" 2>/dev/null || echo "N")
  if [[ "$FC_VAL" != "Y" && "$FC_VAL" != "1" ]]; then
    echo 1 > "$FC_PARAM" 2>/dev/null || true
  fi
fi

# Find all fan targets
shopt -s nullglob
TARGETS=("$REAL_HWMON"/fan*_target)
shopt -u nullglob

if [[ ${#TARGETS[@]} -eq 0 ]]; then
  echo "Error: No fan_target registers found in $REAL_HWMON." >&2
  exit 1
fi

# Pass 1: validate every fan and compute its value before touching any register,
# so a bad fan never leaves the others half-configured.
REGS=()
VALUES=()
for reg in "${TARGETS[@]}"; do
  REAL_REG=$(realpath "$reg" 2>/dev/null || true)
  if [[ -z "$REAL_REG" || ! "$REAL_REG" =~ ^/sys/ ]]; then
    echo "Security error: Fan target does not resolve inside /sys: $REAL_REG" >&2
    exit 1
  fi
  # Verify root ownership
  REG_UID=$(stat -c "%u" "$REAL_REG" 2>/dev/null || echo 1)
  if [[ "$REG_UID" -ne 0 ]]; then
    echo "Security error: Register $REAL_REG is not owned by root (UID $REG_UID)" >&2
    exit 1
  fi

  VALUE=0
  if (( TARGET > 0 )); then
    # Clamp to this fan's own hardware limits
    STEM="${REAL_REG%_target}"
    MIN=$(cat "${STEM}_min" 2>/dev/null || true)
    MAX=$(cat "${STEM}_max" 2>/dev/null || true)
    if [[ ! "$MIN" =~ ^[0-9]+$ || ! "$MAX" =~ ^[0-9]+$ ]] || (( MIN == 0 || MIN > MAX )); then
      echo "Error: ${STEM}_min/_max are missing or invalid ('$MIN'/'$MAX')." >&2
      exit 1
    fi
    VALUE=$TARGET
    (( VALUE >= MIN )) || VALUE=$MIN
    (( VALUE <= MAX )) || VALUE=$MAX
  fi

  REGS+=("$REAL_REG")
  VALUES+=("$VALUE")
done

# Pass 2: write target RPM (0 for auto, or the clamped RPM)
SUMMARY=()
for i in "${!REGS[@]}"; do
  REAL_REG="${REGS[$i]}"
  # Strip world-writable bit if present (remedy legacy chmod 0666)
  chmod o-w "$REAL_REG" 2>/dev/null || true
  # fan*_target can be exposed read-only (0444), observed with the built-in
  # macsmc_hwmon driver when fan_control is enabled at runtime via tmpfiles.
  # kernfs refuses writes to attributes without a write bit, even for root, so
  # grant owner-only write (root:root, never group/world-writable).
  chmod u+w,g-w "$REAL_REG" 2>/dev/null || true

  echo "${VALUES[$i]}" > "$REAL_REG"
  SUMMARY+=("${REAL_REG##*/}=${VALUES[$i]}")
done

if (( TARGET == 0 )); then
  echo "Fan control set to auto (SMC management)"
else
  echo "Fan speed set across ${#REGS[@]} fan(s): ${SUMMARY[*]}"
fi
exit 0
